@page
@model ConfigurationWebUI.Pages.IndexModel
@{
    ViewData["Title"] = "Konfigürasyon Yönetimi";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="display-5 fw-bold text-primary">Konfigürasyon Yönetim Paneli</h1>
        <p class="lead text-muted">Uygulama ayarlarını merkezi olarak yönetin, ekleyin, güncelleyin ve silin.</p>
        <p class="lead text-muted">Yeni kayıtta aktif kutusunu seçiniz</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-5 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-bold">
                @if (Model.IsEditMode)
                {
                    <i class="bi bi-pencil-square me-2"></i> // Kaydı Güncelle
                }
                else
                {
                    <i class="bi bi-plus-circle me-2"></i> //Yeni Kayıt Ekle
                }
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="@(Model.IsEditMode ? "Update" : "Add")">
                    <input type="hidden" name="Id" value="@Model.EditItem.Id" />

                    <div class="form-floating mb-3">
                        <input type="text" name="Name" class="form-control" id="InputName" 
                               value="@Model.EditItem.Name" placeholder="Ad" required />
                        <label for="InputName">Name</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="text" name="Type" class="form-control" id="InputType" 
                               value="@Model.EditItem.Type" placeholder="Tipi" required />
                        <label for="InputType">Type</label>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input type="text" name="Value" class="form-control" id="InputValue" 
                               value="@Model.EditItem.Value" placeholder="Değer" required />
                        <label for="InputValue">Value</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="text" name="ApplicationName" class="form-control" id="InputAppName"
                               value="@(string.IsNullOrEmpty(Model.EditItem.ApplicationName) ? "SERVICE-A" : Model.EditItem.ApplicationName)" 
                               placeholder="Uygulama Adı" required />
                        <label for="InputAppName">Application Name</label>
                    </div>

                    <div class="form-check mb-4">
                        <input type="checkbox" name="IsActive" class="form-check-input" id="CheckActive" value="true" 
                               @(Model.EditItem.IsActive ? "checked" : "") />
                        <label class="form-check-label" for="CheckActive">Aktif mi?</label>
                    </div>

                    <div class="d-grid gap-2">
                        @if (Model.IsEditMode)
                        {
                            <button type="submit" class="btn btn-warning btn-lg fw-bold"><i class="bi bi-pencil me-2"></i> Kaydı Güncelle</button>
                            <form method="post" asp-page-handler="CancelEdit">
                                <button type="submit" class="btn btn-secondary w-100 mt-2">İptal</button>
                            </form>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary btn-lg fw-bold"><i class="bi bi-save me-2"></i> Kaydet</button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light fw-bold">
                <i class="bi bi-list-columns me-2"></i> Konfigürasyon Kayıt Listesi
            </div>
            <div class="card-body p-0">
                @if (Model.Configurations == null || !Model.Configurations.Any())
                {
                    <div class="alert alert-info m-3" role="alert">
                        <i class="bi bi-info-circle me-2"></i> Henüz kayıt bulunamadı. Lütfen yeni bir kayıt ekleyin.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th>Id</th>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Value</th>
                                    <th>Aktif</th>
                                    <th>Application</th>
                                    <th class="text-center">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Configurations)
                                {
                                    <tr class="@(item.IsActive ? "" : "table-danger")"> <td class="fw-bold">@item.Id</td>
                                        <td>@item.Name</td>
                                        <td>@item.Type</td>
                                        <td>@item.Value</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success">Evet</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Hayır</span>
                                            }
                                        </td>
                                        <td>@item.ApplicationName</td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <form method="post" asp-page-handler="Edit">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-info me-1"><i class="bi bi-pencil"></i> Düzenle</button>
                                                </form>
                                                <form method="post" asp-page-handler="Delete">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bu kaydı silmek istediğinizden emin misiniz?');"><i class="bi bi-trash"></i> Sil</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>